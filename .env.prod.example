# Copy to `.env` ON THE SERVER and fill in real values. NEVER commit the real .env.
# DATABASE_URL / REDIS_URL / EMBED_WORKER / TELEGRAM_MODE are set by docker-compose.prod.yml.

# Postgres password (compose builds DATABASE_URL from this). Generate: openssl rand -hex 16
POSTGRES_PASSWORD=

# Platform-operator key that guards POST /sources. Generate: openssl rand -hex 24
SUPERADMIN_API_KEY=

# Signs dashboard JWTs. Generate: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# From @BotFather, and the bot's @username (no @).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
