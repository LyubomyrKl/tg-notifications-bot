# ── Core ───────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000

# ── Database (Postgres) ────────────────────────────────
# Compose service host is "postgres"; for host-run apps use localhost.
DATABASE_URL=postgresql://paedavic:paedavic@localhost:5432/paedavic?schema=public

# ── Redis / BullMQ ─────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Run the delivery worker inside the API process (single-process mode — great for
# local dev and small deployments). Set false when running a dedicated worker.
EMBED_WORKER=true

# ── Auth ───────────────────────────────────────────────
# Platform-operator key guarding the workspace-provisioning bootstrap (POST /sources).
# This is the super-admin (server operator), not a per-workspace admin role.
SUPERADMIN_API_KEY=dev-superadmin-key-change-me
# Signs dashboard session JWTs (email/password login).
JWT_SECRET=dev-jwt-secret-change-mec
JWT_EXPIRES_IN=7d

# ── Telegram ───────────────────────────────────────────
# From @BotFather. Leave empty to boot the API without starting the bot.
TELEGRAM_BOT_TOKEN=
# Public bot username (no @), used to build t.me/<bot>?start=<token> links.
TELEGRAM_BOT_USERNAME=
# "polling" for local dev, "webhook" for production (Hetzner).
TELEGRAM_MODE=polling
# Required only when TELEGRAM_MODE=webhook.
TELEGRAM_WEBHOOK_URL=
