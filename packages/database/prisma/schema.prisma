// Paedavic — Telegram notification platform
// Slice 1 scope: identity (User) + workspace (Source).
// Later slices add Notification, Group, Subscriber, InviteLink, Broadcast via
// their own migrations. Enums/relations here already leave room for those.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Web-dashboard account. Owns one or more workspaces.
/// Single-owner today; the one-to-many relation already supports teams later
/// without restructuring (a future Membership join table would slot in here).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sources Source[]

  @@map("users")
}

/// A publisher workspace. The unit of tenant isolation: every other entity is
/// scoped by sourceId, and a Source can never read/target another's data.
model Source {
  id   String @id @default(cuid())
  name String

  // Web account that owns this workspace.
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Telegram identity of the owner, bound when they open the /start deep-link.
  // Nullable until linked; unique so a Telegram account maps to one workspace.
  telegramUserId BigInt? @unique

  // REST auth for programmatic/external callers. Stores a hash, never the key.
  apiKeyHash String @unique

  // Opaque token embedded in t.me/<bot>?start=<startToken>. Random + DB lookup.
  startToken String @unique

  // Soft-delete only — archived workspaces are excluded, never hard-deleted.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]
  subscribers   Subscriber[]
  groups        Group[]
  inviteLinks   InviteLink[]
  broadcasts    Broadcast[]
  auditLogs     AuditLog[]

  @@index([ownerId])
  @@map("sources")
}

/// Append-only audit trail of meaningful Source actions (broadcast sent,
/// subscriber unsubscribed, …). `actor` is the principal id/transport, `action`
/// a stable verb, `metadata` the action-specific detail. Source-scoped like
/// everything else. Keeps the door open for richer compliance/reporting later.
model AuditLog {
  id       String @id @default(cuid())
  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  actor    String
  action   String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([sourceId, createdAt])
  @@map("audit_logs")
}

enum SubscriberStatus {
  active
  unsubscribed
}

/// An end user who receives notifications from a Source. Identity is the
/// (sourceId, telegramUserId) pair — the same Telegram user is a distinct
/// Subscriber per workspace. Unsubscribed subscribers are excluded from all
/// targeting (consent); `pendingDelete` flags them for later erasure (/stop).
model Subscriber {
  id             String           @id @default(cuid())
  sourceId       String
  source         Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  telegramUserId BigInt
  username       String?
  status         SubscriberStatus @default(active)
  unsubscribedAt DateTime?
  pendingDelete  Boolean          @default(false)
  joinedAt       DateTime         @default(now())

  memberships GroupMember[]
  inviteJoins InviteJoin[]
  recipients  BroadcastRecipient[]

  @@unique([sourceId, telegramUserId])
  @@index([sourceId])
  @@map("subscribers")
}

/// A subscriber segment. `isAll` marks the implicit "All" group that always
/// exists per Source; its membership is every active subscriber, resolved
/// dynamically (no GroupMember rows), so it can't be edited or deleted.
model Group {
  id        String   @id @default(cuid())
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  name      String
  isAll     Boolean  @default(false)
  createdAt DateTime @default(now())

  members     GroupMember[]
  inviteLinks InviteLink[]
  targetedBy  BroadcastTarget[]

  @@unique([sourceId, name])
  @@index([sourceId])
  @@map("groups")
}

/// Many-to-many: a subscriber may belong to many groups. Composite PK makes
/// adds idempotent (re-adding is a no-op upsert).
model GroupMember {
  groupId      String
  subscriberId String
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@id([groupId, subscriberId])
  @@index([subscriberId])
  @@map("group_members")
}

/// A reusable message template in a Source's gallery. `body` may contain named
/// {placeholders}; those names are parsed and cached in `placeholders` so a
/// send can be rejected up front when any are left unfilled.
model Notification {
  id   String @id @default(cuid())
  name String
  body String

  // Optional media attachment (photo/document/…). type stored for send routing.
  mediaUrl  String?
  mediaType String?

  // Parsed placeholder names ({title} → "title"), deduped, cached on write.
  placeholders String[]

  // Tenant owner. Every query is scoped by this; soft-delete via archivedAt.
  sourceId   String
  source     Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inviteLinks InviteLink[]
  broadcasts  Broadcast[]

  @@index([sourceId])
  @@map("notifications")
}

/// A signed deep-link that subscribes whoever opens it. Optionally binds the
/// new subscriber to a Group and carries a default Notification. Random + DB
/// lookup token (prefixed `inv_`); revocable (revokedAt) and optionally
/// expiring. joinCount + InviteJoin rows give per-link attribution.
model InviteLink {
  id       String @id @default(cuid())
  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  token    String @unique

  // Optional bindings — validated to belong to the same Source at creation.
  groupId        String?
  group          Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  notificationId String?
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  expiresAt DateTime?
  revokedAt DateTime?
  joinCount Int       @default(0)
  createdAt DateTime  @default(now())

  joins InviteJoin[]

  @@index([sourceId])
  @@map("invite_links")
}

/// Attribution: which subscriber joined via which link, and when. Unique per
/// (link, subscriber) so reopening a link is idempotent (no double-count).
model InviteJoin {
  id           String     @id @default(cuid())
  inviteLinkId String
  inviteLink   InviteLink @relation(fields: [inviteLinkId], references: [id], onDelete: Cascade)
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  joinedAt     DateTime   @default(now())

  @@unique([inviteLinkId, subscriberId])
  @@index([inviteLinkId])
  @@map("invite_joins")
}

enum BroadcastStatus {
  queued
  sending
  completed
  failed
}

enum RecipientStatus {
  queued
  sent
  failed
  blocked
}

/// One send event. `sendKey` is the idempotency gate: unique per Source, so a
/// retried POST /broadcasts with the same key returns the existing Broadcast
/// instead of double-sending. Audit fields (createdBy/notificationId/targets/
/// timestamps + aggregate counts) record who sent what, to whom, and when.
model Broadcast {
  id       String @id @default(cuid())
  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id])

  sendKey           String          @unique
  status            BroadcastStatus @default(queued)
  placeholderValues Json
  createdBy         String // audit: which principal initiated the send

  totalCount   Int @default(0)
  sentCount    Int @default(0)
  failedCount  Int @default(0)
  blockedCount Int @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  targets    BroadcastTarget[]
  recipients BroadcastRecipient[]

  @@index([sourceId])
  @@map("broadcasts")
}

/// Audit: which groups a broadcast targeted (resolved to recipients at send).
model BroadcastTarget {
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([broadcastId, groupId])
  @@map("broadcast_targets")
}

/// Per-recipient delivery row. Carries the lifecycle status the worker drives:
/// queued → sent | failed | blocked. Unique per (broadcast, subscriber) dedupes
/// the recipient set and makes per-job processing idempotent on retry.
model BroadcastRecipient {
  id           String          @id @default(cuid())
  broadcastId  String
  broadcast    Broadcast       @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  subscriberId String
  subscriber   Subscriber      @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  status       RecipientStatus @default(queued)
  error        String?
  sentAt       DateTime?

  @@unique([broadcastId, subscriberId])
  @@index([broadcastId])
  @@map("broadcast_recipients")
}
